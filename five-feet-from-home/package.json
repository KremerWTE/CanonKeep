    "mammoth": "^1.11.0",
    "marked": "^17.0.1",
    "next": "14.2.15",
    "next-auth": "^5.0.0-beta.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
