# ===========================
# CanonKeep — Root .gitignore
# ===========================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
canon-keep/.next/
canon-keep/out/

# Build artifacts
build/
dist/

# Environment & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo
canon-keep/next-env.d.ts

# Testing
coverage/
.nyc_output

# Misc
.cache/
.temp/
tmp/
